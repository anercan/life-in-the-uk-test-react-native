{
  "name": "life-in-the-uk-client",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:release": "react-native run-android --mode=release",
    "apk-install-debug": "cd android/app/build/outputs/apk/debug && adb install app-debug.apk",
    "apk-install-release": "cd android/app/build/outputs/apk/release && adb install app-release.apk",
    "build-release-aab-clean-cache": "yarn clean-all && react-native build-android --mode=release",
    "build-release-aab": "react-native build-android --mode=release",
    "build-release-apk": "react-native build-android --tasks=assembleRelease",
    "clean": "react-native clean --include metro",
    "clean-android": "rm -rf android/app/.cxx android/app/build android/.gradle android/build && cd android && ./gradlew clean",
    "clean-all": "yarn clean && yarn clean-android",
    "ios": "react-native run-ios --list-devices",
    "start": "react-native start",
    "start-reset-cache": "react-native start --reset-cache"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "23.4.0",
    "@react-native-firebase/app": "23.4.0",
    "@react-native-firebase/crashlytics": "23.4.0",
    "@react-native-firebase/messaging": "23.4.0",
    "@react-native-google-signin/google-signin": "16.0.0",
    "@invertase/react-native-apple-authentication": "2.5.1",
    "@react-navigation/bottom-tabs": "7.4.8",
    "@react-navigation/native": "7.1.18",
    "@react-navigation/stack": "7.4.9",
    "jwt-decode": "^4.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.80.3",
    "react-native-chart-kit": "^6.12.0",
    "react-native-check-version": "^1.3.0",
    "react-native-device-info": "^14.0.1",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-gifted-charts": "1.4.61",
    "react-native-safe-area-context": "5.6.1",
    "react-native-screens": "4.18.0",
    "react-native-svg": "15.13.0",
    "react-native-system-navigation-bar": "^2.6.4",
    "react-native-vector-icons": "^10.1.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-onboarding-swiper": "^1.3.0",
    "react-native-progress": "^5.0.1",
    "react-native-iap": "14.7.17",
    "react-native-nitro-modules": "^0.35.2",
    "react-native-sound": "0.13.0",
    "react-native-in-app-review": "4.4.2",
    "react-native-reanimated": "4.1.3",
    "react-native-worklets": "0.6.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.6",
    "@react-native-community/cli": "20.0.0",
    "@react-native/babel-preset": "0.80.3",
    "@react-native/metro-config": "0.80.3",
    "@types/react": "19.1.0",
    "babel-plugin-module-resolver": "^5.0.2"
  }
}
